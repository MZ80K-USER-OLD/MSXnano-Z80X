10 CLS: PRINT "- 24bit Window Sequential Test -"
20 PO=&HE1: BA=&HB000: LN=256
22 PM=&HE0: REM 'MODE SET'
24 OUT PM,1: REM MODE 1
30 '
40 ' Bank 00: write 00h..FFh
50 OUT PO,0
60 FOR I=0 TO LN-1: POKE BA+I,I: NEXT I
70 '
80 ' Bank 01: write FFh..00h
90 OUT PO,1
100 FOR I=0 TO LN-1: POKE BA+I,255-I: NEXT I
110 '
120 ' Verify bank 00
130 OUT PO,0
140 FOR I=0 TO LN-1
150 IF PEEK(BA+I)<>I THEN PRINT "FAIL B0 @";HEX$(BA+I);" ";HEX$(PEEK(BA+I)): END
160 NEXT I
170 '
180 ' Verify bank 01
190 OUT PO,1
200 FOR I=0 TO LN-1
210 IF PEEK(BA+I)<>(255-I) THEN PRINT "FAIL B1 @";HEX$(BA+I);" ";HEX$(PEEK(BA+I)): END
220 NEXT I
230 '
240 PRINT "RESULT: SUCCESS"
250 OUT PO,0
260 OUT PM,0
270 END