10 ' Z80XASM.BAS - MSX BASIC 2-pass assembler for MSXnano Z80X
20 ' Extended ED/DD ED only. BIT/CB/shift instructions are excluded.
22 CLEAR 500,&HC000
30 DIM MN$(120),OP$(120),FM$(120),LB$(80),LV$(80)
40 N=0: RESTORE 10000
50 READ MN$: IF MN$="!" THEN GOTO 80
60 READ OP$,FM$: N=N+1: MN$(N)=MN$: OP$(N)=OP$: FM$(N)=FM$: GOTO 50
80 PRINT "Z80X ASM  SOURCE DATA -> MEMORY"
85 ER=0: PS=1: OG$="": RESTORE 20000: PRINT "--- PASS 1 ---": GOSUB 1000
86 IF ER=1 OR LEN(OG$)=0 THEN PRINT "?NO ORG FOUND": END
88 ER=0: PC$=OG$: PS=2: PRINT "--- PASS 2 ---": PRINT "ADDRESS BINARY MNEMONIC"
89 RESTORE 20000: GOSUB 1000
130 IF ER=1 THEN END
140 V$=OG$:GOSUB 2900:PRINT "DONE ";VAL(PC$)-VAL(OG$);" BYTES AT ";HX$
150 END
1000 ' one pass
1010 READ S$: PRINT S$:IF S$="END" THEN RETURN
1015 IF LEFT$(S$,4)="ORG " GOTO 1040
1020 GOSUB 3100: IF LEN(S$)=0 THEN GOTO 1010
1030 IF RIGHT$(S$,1)=":" THEN LB$=LEFT$(S$,LEN(S$)-1):GOTO 1031 ELSE GOTO 1050
1031 IF PS=1 THEN GOSUB 2300:GOTO 1010
1032 GOSUB 2400:S$="":GOTO 1010
1040 'ORG 
1041 X$=MID$(S$,5):GOSUB 3200:PC$=X$:OG$=X$:print OG$:GOTO 1010
1050 GOSUB 2000: IF IX=0 THEN PRINT "?UNKNOWN ";S$:ER=1:RETURN
1055 'PRINT "  -> ";MN$(IX)
1060 GOSUB 2500: IF PS=1 THEN PC$=STR$(VAL(PC$)+SZ) ELSE GOSUB 2600
1070 GOTO 1010
2000 ' find mnemonic by prefix
2010 IX=0:ML=0
2020 FOR I=1 TO N
2030 L=LEN(MN$(I)):IF LEFT$(S$,L)<>MN$(I) THEN GOTO 2036
2031 IF L=LEN(S$) THEN GOTO 2035
2032 IF MID$(S$,L+1,1)=" " THEN GOTO 2035
2033 IF RIGHT$(MN$(I),1)="," THEN GOTO 2035
2034 IF RIGHT$(MN$(I),1)<>" " THEN GOTO 2036
2035 IF L>ML THEN IX=I:ML=L
2036 NEXT I
2050 RETURN
2300 ' define label
2310 FOR I=1 TO NL:IF LB$(I)=LB$ THEN PRINT "?DUP LABEL ";LB$:ER=1:RETURN
2320 NEXT I:NL=NL+1:LB$(NL)=LB$:LV$(NL)=PC$:RETURN
2400 ' label must already exist on pass 2
2410 FOR I=1 TO NL:IF LB$(I)=LB$ THEN RETURN
2420 NEXT I:PRINT "?BAD LABEL ";LB$:ER=1:RETURN
2500 ' calculate instruction size
2510 F$=FM$(IX):SZ=1
2515 FOR K=1 TO LEN(OP$(IX)):IF MID$(OP$(IX),K,1)=" " THEN SZ=SZ+1
2516 NEXT K
2520 IF F$="U24" THEN SZ=SZ+3
2530 IF F$="S16" THEN SZ=SZ+2
2540 IF F$="D8" THEN SZ=SZ+1
2550 RETURN
2600 ' emit opcode and operands
2610 A$=PC$:O$=OP$(IX):C$="":GOSUB 2700
2620 F$=FM$(IX):IF F$="0" THEN PC$=STR$(VAL(PC$)+SZ):GOSUB 2810:RETURN
2630 P=INSTR(S$,","):IF P=0 THEN X$=MID$(S$,LEN(MN$(IX))+1):GOTO 2640
2631 X$=MID$(S$,P+1)
2640 GOSUB 3000
2650 IF F$="D8" THEN GOTO 2654
2651 IF F$="S16" THEN GOTO 2661
2652 IF F$="U24" THEN GOTO 2670
2653 goto 2680
2564 'D8
2655 B=VAL(V$) AND 255:GOSUB 2800:PC$=STR$(VAL(PC$)+1)
2656 GOSUB 2810:RETURN
2660 'S16 
2661 W=VAL(V$)-VAL(PC$)-2:B=W AND 255:GOSUB 2800
2662 B=(W\256) AND 255:PC$=STR$(VAL(PC$)+1):GOSUB 2800
2663 PC$=STR$(VAL(PC$)+1):GOSUB 2810:RETURN
2670 '
2671 V$=X$:GOSUB 3000:GOSUB 2900
2672 B=VAL("&H"+MID$(HX$,5,2)):GOSUB 2800
2673 B=VAL("&H"+MID$(HX$,3,2)):PC$=STR$(VAL(PC$)+1):GOSUB 2800
2674 B=VAL("&H"+MID$(HX$,1,2)):PC$=STR$(VAL(PC$)+1):GOSUB 2800
2675 PC$=STR$(VAL(PC$)+1)
2680 GOSUB 2810:RETURN
2700 ' emit hexadecimal opcode bytes
2710 J=1
2720 IF J>LEN(O$) THEN RETURN
2730 IF MID$(O$,J,1)=" " THEN J=J+1:GOTO 2720
2740 B=VAL("&H"+MID$(O$,J,2)):GOSUB 2800
2750 PC$=STR$(VAL(PC$)+1):J=J+2:GOTO 2720
2800 IF PS=2 THEN POKE VAL(PC$),B:C$=C$+RIGHT$("0"+HEX$(B),2)+" "
2810 IF PS<>2 THEN RETURN
2811 V$=A$:GOSUB 2900:B$=HX$
2812 PRINT B$+" "+LEFT$(C$,LEN(C$)-1)+" "+MN$(IX):RETURN
2900 ' convert decimal or &H-prefixed hex string V$ to 24bit hex string HX$, one byte at a time
2905 IF LEFT$(V$,2)="&H" THEN HX$=MID$(V$,3):RETURN
2910 T=VAL(V$):HX$=""
2920 FOR K=1 TO 3
2930 HX$=RIGHT$("0"+HEX$(T AND 255),2)+HX$:T=T\256
2940 NEXT K
2950 RETURN
3000 ' evaluate decimal, hex, or label in X$
3005 IF LEN(X$)>0 AND LEFT$(X$,1)=" " THEN X$=MID$(X$,2):GOTO 3005
3006 IF LEN(X$)>0 AND RIGHT$(X$,1)=" " THEN X$=LEFT$(X$,LEN(X$)-1):GOTO 3006
3010 IF LEFT$(X$,2)="&H" THEN V$=X$:RETURN
3020 IF X$>="0" AND X$<="9" THEN V$=X$:RETURN
3030 FOR I=1 TO NL:IF LB$(I)=X$ THEN V$=LV$(I):RETURN
3040 NEXT I:PRINT "?VALUE ";X$:ER=1:V$="0":RETURN
3100 ' trim spaces
3110 IF LEN(S$)>0 AND LEFT$(S$,1)=" " THEN S$=MID$(S$,2):GOTO 3110
3120 IF LEN(S$)>0 AND RIGHT$(S$,1)=" " THEN S$=LEFT$(S$,LEN(S$)-1):GOTO 3120
3130 RETURN
3200 ' trim operand spaces
3210 IF LEN(X$)>0 AND LEFT$(X$,1)=" " THEN X$=MID$(X$,2):GOTO 3210
3220 IF LEN(X$)>0 AND RIGHT$(X$,1)=" " THEN X$=LEFT$(X$,LEN(X$)-1):GOTO 3220
3230 RETURN
